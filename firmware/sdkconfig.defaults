# ---- Stacks (Rust std needs more than the C defaults)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# ---- Flash: WROOM-32D has 4 MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ---- Task watchdog: the control loop feeds it every 100 ms. If it hangs for
# 5 s the chip panics and reboots. During reboot GPIO15 floats, the fans' own
# pull-up runs them at 100 %, and the firmware brings them back to the safe
# speed within a second.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# ---- Brownout detector on (5 V buck sag → clean reset instead of glitches)
CONFIG_ESP_BROWNOUT_DET=y

# ---- BLE only (NimBLE host, controller in BLE-only mode). No Wi-Fi anywhere.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=7000
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
# No pairing/bonding: auth is the app-level HMAC (see protocol::auth)
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
